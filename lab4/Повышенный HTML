<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Бронирование мероприятия</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<form onsubmit="return calculate()">
    <h2>Бронирование</h2>

    <label>Имя:</label>
    <input type="text" id="name" required>

    <label>E-mail:</label>
    <input type="email" id="email" required>

    <label>Категория билета:</label>
    <select id="ticket">
        <option value="10000">Стандарт — 10 000 ₸</option>
        <option value="20000">VIP — 20 000 ₸</option>
        <option value="30000">Премиум — 30 000 ₸</option>
    </select>

    <label>Количество:</label>
    <input type="number" id="count" min="1" max="10" required>

    <p>Дополнительные опции:</p>

    <input type="checkbox" class="option" value="5000"> Парковка — 5 000 ₸<br>
    <input type="checkbox" class="option" value="3000"> Обед — 3 000 ₸<br>
    <input type="checkbox" class="option" value="7000"> Экскурсия — 7 000 ₸<br>

    <button type="submit">Забронировать</button>
</form>

<div id="result"></div>

<script>
function calculate() {
    let count = document.getElementById("count").value;
    let ticket = document.getElementById("ticket").value;

    if (count < 1 || count > 10) {
        alert("Количество билетов от 1 до 10");
        return false;
    }

    let total = ticket * count;

    let options = document.querySelectorAll(".option:checked");

    options.forEach(function(option) {
        total += option.value * count;
    });

    document.getElementById("result").innerHTML =
        "<h3>Бронирование подтверждено</h3>" +
        "<p>Итоговая стоимость: <b>" + total + " ₸</b></p>";

    return false;
}
</script>

</body>
</html>
