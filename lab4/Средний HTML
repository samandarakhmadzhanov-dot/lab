<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Анкета сотрудника</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<form onsubmit="return checkForm()">
    <h2>Анкета сотрудника</h2>

    <label>ФИО:</label>
    <input type="text" id="name" required>

    <label>Возраст:</label>
    <input type="number" id="age" required>

    <label>Отдел:</label>
    <select id="department">
        <option>IT</option>
        <option>Бухгалтерия</option>
        <option>Маркетинг</option>
        <option>Продажи</option>
    </select>

    <p>Формат работы:</p>

    <input type="radio" name="work" value="Офис" required> Офис<br>
    <input type="radio" name="work" value="Удалённо"> Удалённо<br>
    <input type="radio" name="work" value="Гибрид"> Гибрид<br>

    <button type="submit">Отправить</button>
</form>

<script>
function checkForm() {
    let age = document.getElementById("age").value;

    if (age < 18 || age > 70) {
        alert("Возраст должен быть от 18 до 70 лет");
        return false;
    }

    alert("Анкета отправлена!");
    return true;
}
</script>

</body>
</html>
