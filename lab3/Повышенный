class Wallet:
    def __init__(self, pin):
        self.__pin = pin
        self.__balance = 0
        self.history = []

    def add(self, x):
        self.__balance += x
        self.history.append(f"+{x}")

    def pay(self, x):
        self.__balance -= x
        self.history.append(f"-{x}")

w = Wallet("1234")
w.add(10000)
w.pay(2000)

print("Баланс:", w._Wallet__balance)
print("История:", w.history)
